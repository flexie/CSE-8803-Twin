author = {Ed Kragh and Phil Christie},
title = {Seismic repeatability, normalized rms, and predictability},
journal = {The Leading Edge},
volume = {21},
number = {7},
pages = {640-647},
year = {2002},
doi = {10.1190/1.1497316},
URL = {https://doi.org/10.1190/1.1497316},
eprint = {https://doi.org/10.1190/1.1497316},
abstract = { Time-lapse data are increasingly used to study production-induced changes in the seismic response of a reservoir as part of a reservoir management program. However, residual differences in the repeated time-lapse data that are independent of changes in the subsurface geology impact the effectiveness of the method. These differences depend on many factors such as signature control, streamer positioning, and recording fidelity differences between the two surveys. Such factors may be regarded as contributing to the time-lapse noise and any effort designed to improve the time-lapse signal-to-noise ratio must address the quantifiable repeatability of the seismic survey. }
}

